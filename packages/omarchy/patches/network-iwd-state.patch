diff --git a/bin/omarchy-network-status b/bin/omarchy-network-status
index e97c6a29b..6addeb50f 100755
--- a/bin/omarchy-network-status
+++ b/bin/omarchy-network-status
@@ -20,7 +20,7 @@ case "${1:-}" in
 esac
 
 print_status() {
-  local device nm state ssid signal freq
+  local device nm state ssid signal freq link
 
   device=$(ip route get "$internet_probe" 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
 
@@ -34,6 +34,20 @@ print_status() {
     return
   fi
 
+  # Kebun (iwd): v4.0.2 kept a no-nmcli branch here; without it an iwd host
+  # reads "disconnected" on a live Wi-Fi link. Read the link from iw instead.
+  if ! omarchy-cmd-present nmcli; then
+    link=$(iw dev "$device" link 2>/dev/null)
+    if [[ -z $link || $link == "Not connected"* ]]; then
+      printf 'disconnected\t\t\t\n'
+      return
+    fi
+    ssid=$(awk '/SSID:/ { sub(/.*SSID: /, ""); print; exit }' <<<"$link")
+    freq=$(awk '/freq:/ { print $2; exit }' <<<"$link")
+    printf 'wifi\t%s\t\t%s\n' "${ssid:-$device}" "$freq"
+    return
+  fi
+
   nm=$(nmcli -t -f GENERAL.STATE,GENERAL.CONNECTION dev show "$device" 2>/dev/null)
   state=$(awk -F: '$1 == "GENERAL.STATE" { print $2; exit }' <<<"$nm")
   ssid=$(awk -F: '$1 == "GENERAL.CONNECTION" { print $2; exit }' <<<"$nm")
diff --git a/shell/plugins/panels/network/Model.js b/shell/plugins/panels/network/Model.js
index 36a62b1ed..c18122606 100644
--- a/shell/plugins/panels/network/Model.js
+++ b/shell/plugins/panels/network/Model.js
@@ -20,6 +20,16 @@ function wifiIconFor(strength) {
   return icons[index]
 }
 
+// Kebun (iwd): the script layer reports signal in dBm while Quickshell's
+// NetworkManager backend reports a 0-1 fraction, so convert dBm onto the
+// 0-100 percent scale wifiIconFor expects. Classic wireless-tools mapping:
+// -100 dBm reads as 0, -50 dBm (and anything hotter) as 100.
+function signalPercentFromDbm(dbm) {
+  var value = parseFloat(dbm)
+  if (!isFinite(value)) return -1
+  return Math.max(0, Math.min(100, Math.round((value + 100) * 2)))
+}
+
 // The connected network's own strength comes from the access points
 // Quickshell grouped under its SSID. When it has none (an OWE transition-mode
 // network between scans files the in-use access point under its hidden
@@ -409,6 +419,7 @@ if (typeof module !== "undefined") {
   module.exports = {
     parseNetworkStatus: parseNetworkStatus,
     wifiIconFor: wifiIconFor,
+    signalPercentFromDbm: signalPercentFromDbm,
     connectionIcon: connectionIcon,
     connectedSignalStrength: connectedSignalStrength,
     parseActiveApSignal: parseActiveApSignal,
