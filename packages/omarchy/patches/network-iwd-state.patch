+// Kebun (iwd): the script layer reports signal in dBm while Quickshell's
+// NetworkManager backend reports a 0-1 fraction, so convert dBm onto the
+// 0-100 percent scale wifiIconFor expects. Classic wireless-tools mapping:
+// -100 dBm reads as 0, -50 dBm (and anything hotter) as 100.
+function signalPercentFromDbm(dbm) {
+  var value = parseFloat(dbm)
+  if (!isFinite(value)) return -1
+  return Math.max(0, Math.min(100, Math.round((value + 100) * 2)))
+}
+
 function connectionIcon(kind, signalStrength) {
   if (kind === "wifi") return wifiIconFor(signalStrength)
   if (kind === "ethernet") return "󰈀"
