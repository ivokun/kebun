--- a/bin/omarchy-launch-browser
+++ b/bin/omarchy-launch-browser
@@ -4,7 +4,18 @@
 # omarchy:args=[url]
 
 default_browser=$(omarchy-cmd-default-browser)
-browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/$default_browser 2>/dev/null | head -1)
+# Kebun: NixOS surfaces per-user package entries (google-chrome.desktop lives
+# in /etc/profiles/per-user/<user>/share) through XDG_DATA_DIRS. The Arch-era
+# fixed path list missed them, leaving browser_exec empty; uwsm-app then failed
+# with `Command not found: ""`.
+browser_exec=""
+IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-$HOME/.nix-profile/share:/usr/local/share:/usr/share}"
+for data_dir in "${data_dirs[@]}"; do
+  entry="$data_dir/applications/$default_browser"
+  [[ -r $entry ]] || continue
+  browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$entry" | head -1)
+  [[ -n $browser_exec ]] && break
+done
 
