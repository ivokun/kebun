diff -Naur a/bin/omarchy-capture-screenrecording b/bin/omarchy-capture-screenrecording
--- a/bin/omarchy-capture-screenrecording	2026-09-27 14:07:22.380857852 +0800
+++ b/bin/omarchy-capture-screenrecording	2026-09-27 14:07:22.414414155 +0800
@@ -35,6 +35,8 @@
 FULLSCREEN="false"
 STOP_RECORDING="false"
 RECORDING_FILE="/tmp/omarchy-screenrecord-filename"
+# Match Arch's bare argv[0] and Nix's absolute .wrapped executable path.
+RECORDER_PROCESS_PATTERN='^(.*/)?gpu-screen-recorder( |$)'
 REGION_FILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-screenrecord-region"
 LOG_FILE=$([[ ${OMARCHY_SCREENRECORD_DEBUG:-false} == "true" ]] && echo "/tmp/omarchy-screenrecord.log" || echo "/dev/null")

@@ -202,11 +204,11 @@
 }

 stop_screenrecording() {
-  pkill -SIGINT -f "^gpu-screen-recorder" # SIGINT required to save video properly
+  pkill -SIGINT -f "$RECORDER_PROCESS_PATTERN" # SIGINT required to save video properly

   # Wait a maximum of 5 seconds to finish before hard killing
   local count=0
-  while pgrep -f "^gpu-screen-recorder" >/dev/null && ((count < 50)); do
+  while pgrep -f "$RECORDER_PROCESS_PATTERN" >/dev/null && ((count < 50)); do
     sleep 0.1
     count=$((count + 1))
   done
@@ -214,8 +216,8 @@
   toggle_screenrecording_indicator
   cleanup_webcam

-  if pgrep -f "^gpu-screen-recorder" >/dev/null; then
-    pkill -9 -f "^gpu-screen-recorder"
+  if pgrep -f "$RECORDER_PROCESS_PATTERN" >/dev/null; then
+    pkill -9 -f "$RECORDER_PROCESS_PATTERN"
     omarchy-notification-send -u critical -t 5000 "Screen recording error" "Recording process had to be force-killed. Video may be corrupted."
   else
     finalize_recording
@@ -247,7 +249,7 @@
 }

 screenrecording_active() {
-  pgrep -f "^gpu-screen-recorder" >/dev/null
+  pgrep -f "$RECORDER_PROCESS_PATTERN" >/dev/null
 }

 finalize_recording() {
